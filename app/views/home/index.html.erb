<% graphic = TimelineGraphic.new %>

<div class="timeline-page" data-controller="timeline">
  <div class="timeline-header">
    <div class="timeline-label">
      → ANALYSE CHRONOLOGIQUE
    </div>
    <h1>C'était mieux avant ?</h1>
    <div class="timeline-accordion" data-controller="accordion">
      <button class="timeline-accordion-button" data-accordion-target="button" aria-expanded="false" aria-controls="timeline-description" data-action="click->accordion#toggle">
        <span class="timeline-accordion-label">En savoir plus</span>
      </button>
      <div class="timeline-accordion-content" id="timeline-description" data-accordion-target="content" aria-expanded="false">
        <p class="timeline-tagline">
          Les dates correspondent aux périodes où les avancées sont adoptés par la majorité de la population en France métropolitaine, pas leur invention.
          Elles peuvent ne pas être totales mais représentent une amélioration significative pour la société.
          Les disparitions de phénomènes délétères ou nuisibles à la société sont également représentées.
        </p>
      </div>
    </div>
  </div>

  <div class="era-buttons" data-controller="era-modal">
    <% @eras.each do |era| %>
      <% slug = era.name.parameterize %>
      <button class="era-button" data-action="click->era-modal#open" data-era-modal-id-param="<%= era.id %>">
        <%= era_image_tag(slug, "buttons", alt: era.name, classes: "era-button-portrait", size: 50) %>
        <span class="era-button-text"><%= era.question %></span>
      </button>
    <% end %>

    <% @eras.each do |era| %>
      <% linked_asset_ids = era.comments.map(&:asset_id) %>
      <% slug = era.name.parameterize %>
      <div class="era-modal-overlay" data-era-modal-target="overlay" data-era-modal-id="<%= era.id %>" data-action="click->era-modal#closeBackground">
        <div class="era-modal" data-action="click->era-modal#stopPropagation">
          <button class="era-modal-close" data-action="click->era-modal#close" aria-label="Fermer">&times;</button>
          <% era_index = @eras.index(era) %>
          <% if era_index && era_index > 0 %>
            <button class="era-modal-nav era-modal-nav-prev" data-action="click->era-modal#navigate" data-era-modal-id-param="<%= @eras[era_index - 1].id %>" aria-label="Ère précédente">&lsaquo;</button>
          <% end %>
          <% if era_index && era_index < @eras.length - 1 %>
            <button class="era-modal-nav era-modal-nav-next" data-action="click->era-modal#navigate" data-era-modal-id-param="<%= @eras[era_index + 1].id %>" aria-label="Ère suivante">&rsaquo;</button>
          <% end %>
          <div class="era-modal-content">
            <% hero_path = era_hero_path(slug) %>
            <%= tag.div class: class_names("era-modal-hero", "era-image-placeholder" => !hero_path),
                  style: (hero_path ? "background-image: url('#{image_path(hero_path)}');" : nil) do %>
              <span class="era-hero-ia-badge">IA</span>
            <% end %>
            <%= era_image_tag(slug, "buttons", alt: era.name, classes: "era-modal-portrait", size: 150) %>
            <div class="era-modal-body">
              <div class="era-modal-scroll">
                <h2 class="era-modal-title"><%= era.question %></h2>
                <% if era.description.present? %>
                  <p class="era-modal-description"><%= era.description %></p>
                <% end %>
                <% if era.era_bonuses.any? %>
                  <div class="era-modal-bonuses">
                    <% era.era_bonuses.each do |eb| %>
                      <span class="era-bonus-chip" data-tooltip="<%= eb.description %>">
                        <%= eb.bonus.name %>
                      </span>
                    <% end %>
                  </div>
                <% end %>
                <p class="era-modal-dates">
                  <%= era.start_year.year %> &mdash; <%= era.end_year.year %>
                </p>
              </div>
              <div class="era-modal-tags">
                <% @assets.each do |asset| %>
                  <% if linked_asset_ids.include?(asset.id) %>
                    <% comment = era.comments.find { |c| c.asset_id == asset.id } %>
                    <% tag_class = if asset.phenomenom? || asset.curse?
                      'era-tag-curse'
                    elsif comment.coming?
                      'era-tag-coming'
                    else
                      'era-tag-linked'
                    end %>
                    <span class="era-tag <%= tag_class %>" data-tooltip="<%= comment.description %>">
                      <%= asset.name %>
                    </span>
                  <% else %>
                    <% unlinked_class = asset.phenomenom? || asset.curse? ? 'era-tag-unlinked-phenom' : 'era-tag-unlinked' %>
                    <span class="era-tag <%= unlinked_class %>">
                      <%= asset.name %>
                    </span>
                  <% end %>
                <% end %>
              </div>
              <div class="era-modal-legend">
                <span class="era-legend-item"><span class="era-legend-swatch era-legend-exists"></span> Existe</span>
                <span class="era-legend-item"><span class="era-legend-swatch era-legend-curse"></span> Existe (négatif)</span>
                <span class="era-legend-item"><span class="era-legend-swatch era-legend-coming"></span> En développement</span>
                <span class="era-legend-item"><span class="era-legend-swatch era-legend-none"></span> N'existe pas</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="timeline-container">
    <div class="timeline-scroll">
      <div style="min-width: max-content;">
        <!-- En-tête avec les décennies -->
        <div class="timeline-header-row">
          <div class="timeline-era-label">
            <div class="timeline-era-label-text">Avancée \ Année</div>
          </div>
          <% graphic.decades_count.times do |i| %>
            <% decade = graphic.max_decade - (i * 10) %>
            <div class="timeline-decade"><%= decade %></div>
          <% end %>
        </div>

        <!-- Corps du graphique -->
        <div class="timeline-rows">
          <% graphic.asset_bars.each do |bar| %>
            <div class="timeline-row">
              <!-- Nom et commentaire de l'asset (fixe à gauche) -->
              <div class="timeline-asset-name">
                <div class="timeline-asset-name-text">
                  <%= bar.asset.name %>
                </div>
              </div>

              <!-- Frise chronologique -->
              <div class="timeline-bars-container" style="min-width: <%= graphic.min_width %>px;">
                <!-- Barre de l'asset -->
                <div class="timeline-bar" style="left: <%= bar.left_pos %>px; width: <%= bar.bar_width %>px; background-color: <%= bar.asset.color %>;">
                  <div class="timeline-bar-text">
                    <%= bar.asset.comment %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

