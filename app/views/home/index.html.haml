- graphic = TimelineGraphic.new(@assets)

%div.w-full.p-6
  %h1.text-3xl.font-bold.mb-8 Frise chronologique des avancées humaines

  %div.overflow-x-auto
    %div.min-w-max
      / En-tête avec les décennies
      %div.flex.sticky.top-0.bg-white.z-20.shadow-sm.border-b
        %div.w-48.shrink-0
        - graphic.decades_count.times do |i|
          - decade = graphic.max_decade - (i * 10)
          %div.w-32.shrink-0.text-center.text-sm.font-medium.text-gray-600.p-2.border-r.border-gray-200.last:border-r-0
            = decade

      / Corps du graphique
      %div
        - graphic.asset_bars.each do |bar|
          %div.flex.p-3.mb-2
            / Nom et commentaire de l'asset (fixe à gauche)
            %div.w-48.shrink-0.sticky.left-0.bg-white.z-10.flex.items-center.pr-4.font-medium.shadow-sm
              %div
                = bar.asset.name

            / Frise chronologique
            %div.relative.h-full.flex-1{style: "min-width: #{graphic.min_width}px"}
              / Barre de l'asset
              %div.absolute.h-full.rounded-lg.opacity-80.hover:opacity-100.transition-opacity{style: "left: #{bar.left_pos}px; width: #{bar.bar_width}px; background-color: #{bar.asset.color};"}
                = bar.asset.comment
