%div{class:"flex justify-between items-center"}
  - (0..DateTime.now.year).to_a.reverse.each do |year|
    - if year % 10 == 0
      %div{class:"min-w-10 m-3 font-bold"}
        = year
    - else
      %div{class:"min-w-2 m-3"}
        ⋅

%div{class:""}
  - Asset.all.each do |asset|
    %div{class:"min-w-36 m-3"}
      = asset.name
